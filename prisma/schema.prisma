// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Visit {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  path      String
  referrer  String?
  userAgent String?
  country   String?
  clientId  String?
}


